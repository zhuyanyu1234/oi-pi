{
  "name": "oi-pi",
  "version": "1.0.0",
  "description": "信奥助教：终端里的 C++ 信息学竞赛教练（提问式教学 + OJ 式判题）",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oi-pi": "dist/tui.js"
  },
  "files": [
    "dist",
    "prompts",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/tui.ts",
    "compile": "tsc -p tsconfig.build.json",
    "prepack": "pnpm compile",
    "build": "pnpm pack",
    "smoke": "tsx src/smoke.ts",
    "smoke:ui": "tsx src/smoke-components.ts",
    "smoke:judge": "tsx src/smoke-judge-e2e.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
